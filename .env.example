# Server Configuration
PORT=4000

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# MSG91 Configuration (Email Connections via Gmail / External Connection)
# Docs: https://msg91.com/help/email/email-connections
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_EMAIL_INTEGRATION_ID=859
MSG91_EMAIL_TEMPLATE_ID=your_msg91_email_template_id_here

# Optional: MSG91 SMS Configuration (if SMS OTP is enabled)
MSG91_TEMPLATE_ID=your_sms_template_id
MSG91_SENDER_ID=your_sender_id

# OTP Policy Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP Mailer (Fallback for transactional notifications outside OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
